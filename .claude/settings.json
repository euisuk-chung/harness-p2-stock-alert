{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(gh pr merge:*)",
      "Bash(git push origin main:*)",
      "Edit(cases/**)",
      "Edit(requests/*/sources/**)",
      "Skill(drafter-rules)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/show_status.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect_sources.py"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/run_review.py"
            ],
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "run",
              "python",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/next_step.py"
            ],
            "timeout": 120
          }
        ]
      }
    ]
  }
}